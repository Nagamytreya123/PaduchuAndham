{
  "name": "paduchuandham-ecommerce",
  "private": true,
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev --prefix server\" \"wait-on tcp:127.0.0.1:4000 && npm run dev --prefix client\"",
    "build": "npm run build --prefix client && npm run build --prefix server",
    "start": "npm run start --prefix server",
    "seed": "npm run seed --prefix server",
    "seed:products": "npm run seed:products --prefix server",
    "cloudflare:whoami": "wrangler whoami",
    "cloudflare:zones": "python infra/cloudflare-api.py zones",
    "cloudflare:dns": "python infra/cloudflare-api.py dns",
    "cloudflare:deploy": "wrangler deploy --config infra/cloudflare-worker/wrangler.toml",
    "bench:api": "node infra/bench-api.mjs",
    "bench:ui": "node infra/lighthouse-ui.mjs",
    "verify:redis": "bash infra/verify-redis.sh"
  },
  "devDependencies": {
    "chrome-launcher": "^1.1.2",
    "concurrently": "^9.1.2",
    "lighthouse": "^12.3.0",
    "playwright": "^1.51.0",
    "wait-on": "^8.0.1",
    "wrangler": "^4.127.1"
  },
  "dependencies": {
    "lucide-react": "^1.45.0",
    "motion": "^12.43.0"
  }
}
