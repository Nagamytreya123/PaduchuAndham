# Local dev: leave unset — Vite proxies /api to the server on :4000.
# Production build: set VITE_API_URL to your API Gateway URL (see infra/sam outputs).
# VITE_API_URL=https://4cntwh9o4m.execute-api.ap-south-1.amazonaws.com

# Do not set VITE_MEDIA_ORIGIN — uploads resolve via VITE_API_URL / same-origin /api.

# Google Analytics 4 (optional — omit to disable client analytics)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
