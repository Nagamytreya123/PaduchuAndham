# PaduchuAndham AWS deployment config — copy to infra/config.env and fill in values (never commit config.env)

AWS_REGION=ap-south-1
ACM_REGION=us-east-1

# Primary production URL (must match CLIENT_URL; www vs apex matters for OAuth)
DOMAIN=www.paduchuandham.com
DOMAIN_ALTERNATE=paduchuandham.com

# Resource prefix (lowercase, no spaces)
PROJECT=paduchuandham

# Source Render API for uploading legacy /uploads files to S3
API_URL=https://4cntwh9o4m.execute-api.ap-south-1.amazonaws.com

# App Runner sizing (cost-conscious — quote values; spaces required by AWS API)
APPRUNNER_CPU="0.25 vCPU"
APPRUNNER_MEMORY="0.5 GB"
