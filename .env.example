# Copy to server/.env (never commit real secrets).

# --- Server (server/.env) ---
PORT=4000
DYNAMODB_TABLE=paduchuandham-main
AWS_REGION=ap-south-1
S3_UPLOADS_BUCKET=paduchuandham-uploads-474476202047
JWT_SECRET=change-this-to-a-long-random-string-min-16
JWT_COOKIE_NAME=token
# Public site origin for OAuth redirects and customer-facing links (must match the URL in the browser).
CLIENT_URL=http://localhost:5173
# API/public asset base for emails and absolute /uploads links (local dev: same as CLIENT_URL via Vite proxy).
SERVER_PUBLIC_URL=http://localhost:5173

# Google OAuth — Authorized redirect URI in Google Cloud Console:
#   http://localhost:5173/api/auth/google/callback
# Production: https://www.paduchuandham.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails promoted to admin on first Google login
ADMIN_EMAILS=admin@example.com

# Razorpay — required for checkout (https://dashboard.razorpay.com → Account & Settings → API Keys)
# Use test keys (rzp_test_…) for development. In the dashboard, enable Card, UPI, netbanking, wallets, EMI, Pay Later as needed.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signing secret — OPTIONAL. Only needed if you configure a Razorpay webhook URL to your server.
# Leave empty for test/local: checkout still works; the app verifies payments with KEY_SECRET on the client callback.
RAZORPAY_WEBHOOK_SECRET=

# --- Order confirmation email (customer + admin) after successful payment ---
# Customer: sent to the account email when SMTP_* is set.
# Admin: comma-separated inboxes (optional). Same SMTP is used for both.
ADMIN_ORDER_NOTIFY_EMAIL=

# SMTP (Gmail: use an App Password; host smtp.gmail.com, port 587, SMTP_SECURE=false)
# For product images stored as relative URLs in email HTML, set SERVER_PUBLIC_URL to your public API/site origin.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Admin login OTP (two-factor authentication) — inbox that receives the 6-digit code (separate from SMTP_USER).
ADMIN_OTP_EMAIL=
# Optional when ADMIN_OTP_EMAIL uses a different app password than SMTP_USER.
# ADMIN_OTP_SMTP_PASS=



# Redis — optional locally; recommended in production (Upstash or Render Redis)
# Use the read-write TCP URL from Upstash (TCP tab). Read-only URLs disable catalog cache.
# REDIS_URL=rediss://default:PASSWORD@HOST:6379

# SQS email queue — set automatically on Lambda via SAM (EMAIL_QUEUE_URL). Local dev falls back to inline SMTP.
# EMAIL_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/ACCOUNT_ID/paduchuandham-email-queue

# AWS S3 uploads for jewellery combos (set on App Runner; IAM role provides credentials)
# S3_UPLOADS_BUCKET=paduchuandham-uploads-ACCOUNT_ID
# AWS_REGION=ap-south-1

# Seed users (npm run seed)
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_CUSTOMER_EMAIL=customer@example.com

# Sample catalog: 10 sarees + jewellery products (npm run seed, then npm run seed:products)
# Uses SEED_ADMIN_EMAIL (or admin@example.com) as createdBy.

# --- Client (client/.env or Vercel env) ---
# VITE_API_URL=http://localhost:4000

# Google Analytics 4 — measurement ID from GA Admin → Data streams (G-XXXXXXXX)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Default WhatsApp support number for Contact Us (10-digit Indian mobile, no +91).
# Admin can override in Storefront settings; this is the fallback when none is saved.
SUPPORT_WHATSAPP_MOBILE=9392824278

# Footer social links (optional — admin can override in Storefront settings).
SOCIAL_INSTAGRAM_URL=https://www.instagram.com/paduchu_andham_jewellery/
# SOCIAL_YOUTUBE_URL=
# SOCIAL_FACEBOOK_URL=

# Optional client fallback while site settings load (same format as above).
# VITE_SUPPORT_WHATSAPP_MOBILE=9392824278
